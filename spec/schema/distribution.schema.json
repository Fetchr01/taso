{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taso.video/schema/0.1/distribution.schema.json",
  "title": "Taso distribution manifest 0.1",
  "description": "Soittimen lukema, litistetty manifesti. Ajat millisekunteina kokonaislukuina, sijainnit ja koot suhteessa videon kuva-alaan (0–1).",
  "type": "object",
  "required": ["taso", "kind", "id", "title", "duration", "video", "tracks"],
  "additionalProperties": false,
  "properties": {
    "taso": { "type": "string", "pattern": "^0\\.1$" },
    "kind": { "const": "distribution" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "lang": { "type": "string", "description": "BCP 47" },
    "creator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "$ref": "#/$defs/httpsUrl" }
      },
      "additionalProperties": false
    },
    "duration": { "$ref": "#/$defs/ms" },
    "video": {
      "type": "object",
      "required": ["aspect"],
      "anyOf": [{ "required": ["hls"] }, { "required": ["mp4"] }],
      "properties": {
        "aspect": { "$ref": "#/$defs/aspect" },
        "hls": { "$ref": "#/$defs/httpsUrl" },
        "mp4": { "$ref": "#/$defs/httpsUrl" },
        "poster": { "$ref": "#/$defs/httpsUrl" }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "src"],
        "properties": {
          "family": { "type": "string" },
          "src": { "$ref": "#/$defs/httpsUrl", "description": "WOFF2" },
          "weight": { "type": "string", "description": "Yksi paino tai väli, esim. \"400 700\"" },
          "fallback": { "type": "string", "description": "CSS font-family -pino, jota käytetään jos lataus epäonnistuu" }
        },
        "additionalProperties": false
      }
    },
    "styles": {
      "type": "object",
      "description": "Nimetyt tyylit, joihin kohteet viittaavat. Koot suhteessa videon korkeuteen.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "font": { "type": "string" },
          "size": { "$ref": "#/$defs/unit" },
          "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
          "color": { "$ref": "#/$defs/cssColor" },
          "background": { "$ref": "#/$defs/cssColor" },
          "padding": { "type": "array", "items": { "$ref": "#/$defs/unit" }, "minItems": 1, "maxItems": 4 },
          "radius": { "$ref": "#/$defs/unit" }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "description": "Erikseen ladattavat tiedostot. Avain on kohteiden käyttämä viite.",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["image", "file"] },
          "alt": { "type": "string" },
          "sizes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["w", "h", "src"],
              "properties": {
                "w": { "type": "integer", "minimum": 1 },
                "h": { "type": "integer", "minimum": 1 },
                "type": { "type": "string" },
                "src": { "$ref": "#/$defs/httpsUrl" }
              },
              "additionalProperties": false
            }
          },
          "src": { "$ref": "#/$defs/httpsUrl" },
          "bytes": { "type": "integer", "minimum": 0 },
          "filename": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "description": "Järjestys määrää piirtojärjestyksen: ensimmäinen alimpana.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "items"],
        "properties": {
          "id": { "$ref": "#/$defs/ident" },
          "kind": { "enum": ["overlay", "subtitles", "terminal"] },
          "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
        },
        "additionalProperties": false
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "title"],
        "properties": {
          "start": { "$ref": "#/$defs/ms" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "player": {
      "type": "object",
      "properties": {
        "list": { "type": "boolean", "default": true, "description": "Näytetäänkö 'Nyt ruudulla' -lista" },
        "listLinger": { "$ref": "#/$defs/ms", "default": 8000, "description": "Kuinka kauan kohde pysyy listassa ruudulta poistumisen jälkeen" },
        "shortcuts": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },

  "$defs": {
    "ms": { "type": "integer", "minimum": 0 },
    "unit": { "type": "number", "minimum": 0, "maximum": 1, "description": "Suhteessa videon korkeuteen" },
    "ident": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "anyUrl": { "type": "string", "format": "uri", "pattern": "^(https?|mailto):" },
    "cssColor": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{3,8}|rgba?\\(.*\\)|hsla?\\(.*\\))$" },
    "aspect": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "box": {
      "type": "object",
      "description": "Sijainti ja koko suhteessa videon kuva-alaan. x,y on ankkuripisteen sijainti.",
      "required": ["x", "y", "w"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Jos puuttuu, korkeus määräytyy sisällöstä" },
        "anchor": {
          "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"],
          "default": "top-left"
        },
        "z": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "required": ["t", "box"],
      "properties": {
        "t": { "$ref": "#/$defs/ms" },
        "box": { "$ref": "#/$defs/box" },
        "ease": { "enum": ["linear", "ease-in-out", "step"], "default": "linear" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["copy", "open", "expand", "seek", "none"] },
        "to": { "$ref": "#/$defs/ms", "description": "seek: kohta videossa" }
      },
      "additionalProperties": false
    },
    "itemBase": {
      "type": "object",
      "required": ["id", "type", "start", "end", "content", "box"],
      "properties": {
        "id": { "$ref": "#/$defs/ident" },
        "type": { "enum": ["text", "command", "code", "link", "image", "file", "mention", "hotspot"] },
        "start": { "$ref": "#/$defs/ms" },
        "end": { "$ref": "#/$defs/ms" },
        "content": {
          "type": "string",
          "description": "Kohteen sisältö. Komennossa ja koodissa täsmälleen se merkkijono, joka kopioituu."
        },
        "label": { "type": "string", "description": "Lyhyt nimi listaan, jos content ei sovi sellaisenaan" },
        "style": { "type": "string", "description": "Avain styles-objektiin" },
        "box": { "$ref": "#/$defs/box" },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/keyframe" }, "minItems": 2 },
        "render": { "type": "boolean", "default": true, "description": "false: vain klikattava alue, ei piirretä" },
        "action": { "$ref": "#/$defs/action" },
        "list": { "type": "boolean", "default": true, "description": "Näytetäänkö 'Nyt ruudulla' -listassa" }
      }
    },
    "item": {
      "allOf": [
        { "$ref": "#/$defs/itemBase" },
        {
          "oneOf": [
            {
              "properties": { "type": { "const": "text" } },
              "additionalProperties": true
            },
            {
              "properties": {
                "type": { "const": "command" },
                "shell": { "enum": ["sh", "bash", "zsh", "fish", "powershell", "cmd"], "default": "bash" }
              }
            },
            {
              "properties": {
                "type": { "const": "code" },
                "language": { "type": "string" }
              }
            },
            {
              "required": ["href"],
              "properties": {
                "type": { "const": "link" },
                "href": { "$ref": "#/$defs/anyUrl" }
              }
            },
            {
              "required": ["asset"],
              "properties": {
                "type": { "const": "image" },
                "asset": { "type": "string" }
              }
            },
            {
              "required": ["asset"],
              "properties": {
                "type": { "const": "file" },
                "asset": { "type": "string" }
              }
            },
            {
              "required": ["handle"],
              "properties": {
                "type": { "const": "mention" },
                "handle": {
                  "type": "object",
                  "required": ["platform", "id"],
                  "properties": {
                    "platform": { "enum": ["x", "github", "youtube", "mastodon", "bluesky", "instagram", "tiktok", "linkedin"] },
                    "id": { "type": "string" },
                    "instance": { "type": "string", "description": "mastodon: palvelimen host" }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "type": { "const": "hotspot" },
                "href": { "$ref": "#/$defs/anyUrl" },
                "asset": { "type": "string" }
              }
            }
          ]
        }
      ]
    }
  }
}
